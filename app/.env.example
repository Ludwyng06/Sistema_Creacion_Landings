# Copia este archivo a .env.local y completa las claves. .env.local nunca se sube a git.

# Base de datos (Prisma + SQLite)
DATABASE_URL=file:./dev.db

# Principal (desde la tarea 24): OpenAI. gpt-5.4-mini y, si responde 429 o 503, gpt-4.1-mini; tope de gasto por día en USD
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_RESPALDO=gpt-4.1-mini
OPENAI_PRESUPUESTO_USD_DIA=2   # al llegar, el enrutador salta a otro proveedor (GET /api/ia/uso muestra el gasto de hoy)
# OPENAI_PRECIOS={"gpt-5.4-mini":[0.75,4.5]}   # USD por millón de tokens (entrada, salida); sobrescribe la tabla de lib/ia/gasto.ts

# Respaldo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite   # si el principal responde 503 o 429; vacío lo desactiva

# Respaldos (compatibles con OpenAI)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TPM=8000                                  # tokens por minuto del plan gratuito; la tarea landing usa una entrada compacta (~4.200 tokens) con max_tokens 3300

CEREBRAS_API_KEY=                               # proveedor principal de texto (gpt-oss-120b: 1.000.000 de tokens al día, 30.000 por minuto, 5 peticiones por minuto). https://cloud.cerebras.ai → API Keys
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_RPM=5                                  # peticiones por minuto del plan; una cola las reparte y nunca se pasa

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free   # gratuito y rápido con JSON largo; openrouter/free elige al azar y puede tardar más de 2 min
OPENROUTER_MODEL_RESPALDO=google/gemma-4-26b-a4b-it:free   # se prueba si el principal responde 429
OPENROUTER_TIMEOUT_MS=45000                    # tercer respaldo, a mejor esfuerzo: no bloquea la construcción más de 45 s

# Comportamiento
IA_MODO=simultaneo            # cascada | simultaneo | duelo
IA_CASCADA=openai,cerebras,gemini,groq,openrouter
IA_TIMEOUT_MS=60000

# Investigación del producto (opcional). https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_PAIS=co
SERPAPI_IDIOMA=es

# Catálogo de tipografías (opcional, solo para `npm run fuentes`; la app usa src/datos/fuentes.json). https://console.cloud.google.com → API «Web Fonts Developer»
GOOGLE_FONTS_API_KEY=

# Datos y medios del espacio (opcionales). Sin clave, la app sigue: NeoWs usa DEMO_KEY y APOD se omite.
# Se crea gratis en https://api.nasa.gov (APOD con DEMO_KEY agota el tiempo; hace falta una clave propia)
NASA_API_KEY=
# Launch Library 2 (The Space Devs): la clave es opcional; sin ella hay un límite por hora. https://ll.thespacedevs.com/docs/
LAUNCH_LIBRARY_KEY=

# Pexels ya no entrega claves nuevas. Si tienes una, se usa; si no, se omite sin error y los bancos de producto salen de Openverse (sin clave) y Wikimedia. https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay (opcional): fotos de uso comercial sin atribución obligatoria. Se crea gratis en https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Fotos de ambiente (opcional; el sistema todavía no la usa). Se crea en https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Imágenes generadas con FLUX por Hugging Face (Grok sale del proyecto). Token gratis con crédito mensual pequeño: https://huggingface.co/settings/tokens
HF_TOKEN=
